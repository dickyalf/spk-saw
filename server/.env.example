# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/spk_saw

# JWT
JWT_SECRET=ganti_dengan_secret_random_yang_panjang_dan_aman
JWT_EXPIRES_IN=7d

# Google Gemini API (untuk parsing CV)
# Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Email (Gmail SMTP, atau SMTP lain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SPK Seleksi Karyawan <no-reply@spksaw.local>"

# Frontend URL (untuk CORS dan link di email)
CLIENT_URL=http://localhost:5173

# Upload
MAX_UPLOAD_MB=5
